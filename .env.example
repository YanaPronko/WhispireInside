SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_app_password

SMTP_FROM_NAME=Шепот внутри
SMTP_TO=your_email@example.com
SMTP_SUBJECT=Новая заявка на консультацию

# Comma-separated list of allowed frontend origins for CORS.
# Example:
# CORS_ALLOWED_ORIGINS=https://yanapronko.github.io,https://whispersinside.com
CORS_ALLOWED_ORIGINS=

# Frontend endpoint for production build (GitHub Pages cannot run PHP).
# Example:
# VITE_FORM_ENDPOINT=https://api.your-domain.com/sendmail/
VITE_FORM_ENDPOINT=

# Web3Forms access key (only if VITE_FORM_ENDPOINT points to Web3Forms).
VITE_WEB3FORMS_ACCESS_KEY=
